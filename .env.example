BOT_TOKEN=your_telegram_bot_token
APP_ENV=local
CLARITY_API_KEY=your_clarity_api_key
PROZORRO_PORTAL_SEARCH_MAX_ITEMS=50
PROZORRO_PORTAL_SEARCH_TIMEOUT_SECONDS=60
RISKUA_DEBTORS_BROWSER_CHANNEL=msedge
RISKUA_DEBTORS_BROWSER_HEADLESS=false

# --- Нова версія (riskua/, docker compose). Змінні вище потрібні лише старому боту. ---
# Токен окремого тестового бота від @BotFather: старий бот на Cloud Run слухає свій токен,
# а два процеси з одним токеном заважають один одному.
RISKUA_BOT_TOKEN=
RISKUA_ENV=local
RISKUA_LOG_LEVEL=INFO
# Пароль бази для docker compose: лише латинські літери й цифри (наприклад, openssl rand -hex 24).
POSTGRES_PASSWORD=
# Адреса бази для запуску бота поза Docker; у Docker її задає docker-compose.yml.
RISKUA_DATABASE_URL=postgresql://riskua:PASSWORD@localhost:5432/riskua
# Для python scripts/check.py --all: тести працюють в окремих схемах і прибирають за собою.
RISKUA_TEST_DATABASE_URL=postgresql://riskua:PASSWORD@localhost:5432/riskua
